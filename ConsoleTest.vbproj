<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Trasforma la console in un'app Windows invisibile -->
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<UseWindowsForms>True</UseWindowsForms>
		<!-- Abilita NotifyIcon e Clipboard -->
		<AssemblyName>NtfyOTPMonitor</AssemblyName>
		<ApplicationIcon>Dtafalonso.ico</ApplicationIcon>
		<RootNamespace>NtfyOTPMonitor</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Dtafalonso.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
	</ItemGroup>

</Project>
